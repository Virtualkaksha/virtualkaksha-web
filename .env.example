DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virtualkaksha?schema=public"
AUTH_SECRET="replace-me"
RESOURCE_STORAGE_PROVIDER="local"
RESOURCE_UPLOAD_MAX_MB="20"
LOCAL_RESOURCE_STORAGE_PATH="./storage/resources"
S3_ENDPOINT="https://s3-compatible-endpoint.example"
S3_REGION="replace-with-storage-region"
S3_BUCKET="replace-with-private-bucket-name"
S3_ACCESS_KEY_ID="replace-with-storage-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret-access-key"
S3_FORCE_PATH_STYLE="false"
